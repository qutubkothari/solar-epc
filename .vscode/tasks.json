{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build solar-epc-web prefix",
			"type": "shell",
			"command": "npm",
			"args": [
				"--prefix",
				"solar-epc-web",
				"run",
				"build"
			],
			"isBackground": false,
			"group": "build"
		},
		{
			"label": "Deploy Hostinger quotation PDF reorder",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-Command",
				"Set-Location 'C:/Users/QK/Documents/GitHub/solar-epc'; ./deploy-hostinger.ps1 -Message 'Reorder quotation writeup sections'"
			],
			"isBackground": false
		}
	]
}