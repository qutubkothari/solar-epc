{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build solar-epc-web",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"build"
			],
			"isBackground": false,
			"group": "build"
		},
		{
			"label": "Build solar-epc-web prefix",
			"type": "shell",
			"command": "npm",
			"args": [
				"--prefix",
				"solar-epc-web",
				"run",
				"build"
			],
			"isBackground": false,
			"group": "build"
		}
	]
}